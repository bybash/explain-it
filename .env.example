# The LLM settings. The app's Settings page reads and writes these in .env;
# a variable set in the environment (as Docker's -e does) wins over .env.

# Any OpenAI-compatible endpoint; OpenRouter by default.
LLM_BASE_URL=https://openrouter.ai/api/v1
# One model for every call.
LLM_MODEL=anthropic/claude-sonnet-5.5
# The key. OPENROUTER_API_KEY is read instead when this is not set.
LLM_API_KEY=

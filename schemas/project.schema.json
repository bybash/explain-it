{
  "$id": "https://raw.githubusercontent.com/bybash/explain-it/main/schemas/project.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "gate": {
      "type": "string",
      "enum": [
        "graph",
        "script",
        "style",
        "preview",
        "render"
      ],
      "description": "The gate the project is at."
    },
    "staleBeats": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40,
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "description": "Beats that reference changed graph elements."
    },
    "origin": {
      "type": "string",
      "enum": [
        "web",
        "mcp"
      ],
      "description": "Where the project was created."
    },
    "sources": {
      "description": "Files the video explains; recorded over MCP, not checked in v1.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "A file path in the explained repository."
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "version",
    "name",
    "gate",
    "staleBeats",
    "origin",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "description": "A project's state."
}

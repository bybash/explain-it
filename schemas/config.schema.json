{
  "$id": "https://raw.githubusercontent.com/bybash/explain-it/main/schemas/config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The JSON Schema for this file, for editors. Ignored by explAIn-it.",
      "type": "string"
    },
    "theme": {
      "default": {},
      "type": "object",
      "properties": {
        "palette": {
          "default": "default",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            {
              "type": "object",
              "properties": {
                "background": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "surface": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "text": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "muted": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "accent": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "categories": {
                  "maxItems": 6,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "description": "Colours for node, edge and zone categories, in order."
                },
                "dark": {
                  "description": "The dark variant; generated from the light palette when missing.",
                  "type": "object",
                  "properties": {
                    "background": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "surface": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "text": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "muted": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "accent": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "categories": {
                      "maxItems": 6,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "description": "Colours for node, edge and zone categories, in order."
                    }
                  },
                  "required": [
                    "background",
                    "surface",
                    "text",
                    "muted",
                    "accent",
                    "categories"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "background",
                "surface",
                "text",
                "muted",
                "accent",
                "categories"
              ],
              "additionalProperties": false
            }
          ]
        },
        "mode": {
          "default": "light",
          "type": "string",
          "enum": [
            "light",
            "dark",
            "both"
          ]
        }
      },
      "additionalProperties": false
    },
    "font": {
      "default": "inter",
      "description": "A bundled font id or an uploaded font.",
      "type": "string",
      "minLength": 1
    },
    "pacing": {
      "default": "relaxed",
      "description": "How unhurried the video is: the pause after each beat and the shortest a beat can be (relaxed: 1 s, 3 s; normal: 0.6 s, 2 s; brisk: 0.3 s, 1.5 s). Animations keep their speed at every pace.",
      "type": "string",
      "enum": [
        "relaxed",
        "normal",
        "brisk"
      ]
    },
    "voice": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "id": {
          "default": "af_heart",
          "description": "A Kokoro voice: a = American, b = British English; f = female, m = male.",
          "type": "string",
          "enum": [
            "af_heart",
            "af_alloy",
            "af_aoede",
            "af_bella",
            "af_jessica",
            "af_kore",
            "af_nicole",
            "af_nova",
            "af_river",
            "af_sarah",
            "af_sky",
            "am_adam",
            "am_echo",
            "am_eric",
            "am_fenrir",
            "am_liam",
            "am_michael",
            "am_onyx",
            "am_puck",
            "am_santa",
            "bf_emma",
            "bf_isabella",
            "bf_alice",
            "bf_lily",
            "bm_george",
            "bm_lewis",
            "bm_daniel",
            "bm_fable"
          ]
        },
        "speed": {
          "default": 1,
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        }
      },
      "additionalProperties": false
    },
    "captions": {
      "default": {},
      "type": "object",
      "properties": {
        "narration": {
          "default": true,
          "type": "boolean"
        },
        "step": {
          "default": true,
          "type": "boolean"
        },
        "size": {
          "default": "M",
          "type": "string",
          "enum": [
            "S",
            "M",
            "L"
          ]
        }
      },
      "additionalProperties": false
    },
    "music": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "mood": {
          "default": "calm",
          "type": "string",
          "enum": [
            "calm",
            "upbeat",
            "technical"
          ]
        },
        "seed": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "volumeDb": {
          "default": -12,
          "description": "The music's level against the voice while nobody speaks, in dB; it dips 6 dB more while the voice speaks. Without a voice the music is the whole mix, brought to the target loudness, so this has no effect.",
          "type": "number",
          "minimum": -60,
          "maximum": 0
        }
      },
      "additionalProperties": false
    },
    "output": {
      "default": {},
      "type": "object",
      "properties": {
        "resolution": {
          "default": "1080p",
          "type": "string",
          "enum": [
            "1080p",
            "720p"
          ]
        }
      },
      "additionalProperties": false
    },
    "cards": {
      "description": "Cards that open and close the video; each can be left out.",
      "type": "object",
      "properties": {
        "title": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "seconds": {
              "description": "How long it holds, in seconds; by its text when missing (3 to 5 s).",
              "type": "integer",
              "minimum": 2,
              "maximum": 10
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "description": "Opens the video: the title in the middle, the description under it."
        },
        "end": {
          "type": "object",
          "properties": {
            "headline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "link": {
              "description": "An http or https URL; also drawn as a QR code, since nobody can click a link in a video.",
              "type": "string",
              "maxLength": 200,
              "pattern": "^https?:\\/\\/[^\\s\\p{Cc}/?#]+[^\\s\\p{Cc}]*$"
            },
            "where": {
              "description": "Where to find the feature.",
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "credit": {
              "description": "Who made the video.",
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "required": [
            "headline"
          ],
          "additionalProperties": false,
          "description": "Closes the video: the headline, the link with its QR code, where to find it, the credit."
        }
      },
      "additionalProperties": false
    },
    "logo": {
      "type": "object",
      "properties": {
        "light": {
          "type": "string",
          "pattern": "^[\\w-][\\w.-]*(\\.png|\\.jpg|\\.jpeg|\\.svg)$"
        },
        "dark": {
          "description": "If only one file is given, it serves both modes.",
          "type": "string",
          "pattern": "^[\\w-][\\w.-]*(\\.png|\\.jpg|\\.jpeg|\\.svg)$"
        },
        "corner": {
          "default": "top-right",
          "type": "string",
          "enum": [
            "top-right",
            "bottom-right"
          ]
        },
        "show": {
          "default": "both",
          "type": "string",
          "enum": [
            "start",
            "end",
            "both",
            "all"
          ]
        }
      },
      "additionalProperties": false,
      "description": "The team's logo: files in assets/, at most 2 MB each.",
      "anyOf": [
        {
          "required": [
            "light"
          ]
        },
        {
          "required": [
            "dark"
          ]
        }
      ]
    },
    "camera": {
      "description": "Each scene's camera, by scene id; a scene not named is framed as it fits.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "zoom": {
            "type": "number",
            "minimum": 1,
            "maximum": 2,
            "description": "1 frames the scene as it fits; 2 is twice as close."
          },
          "x": {
            "type": "number",
            "minimum": -0.5,
            "maximum": 0.5,
            "description": "Moves the scene right (positive) or left, as a share of its area's width."
          },
          "y": {
            "type": "number",
            "minimum": -0.5,
            "maximum": 0.5,
            "description": "Moves the scene down (positive) or up, as a share of its area's height."
          }
        },
        "required": [
          "zoom",
          "x",
          "y"
        ],
        "additionalProperties": false,
        "description": "How a scene is framed: zoomed in and moved from where it fits."
      }
    }
  },
  "additionalProperties": false,
  "description": "Style and output settings. Every field has a default."
}

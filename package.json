{
  "name": "explain-it",
  "version": "0.0.0",
  "description": "Turn any flow into an isometric explainer video.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": "github:bybash/explain-it",
  "bin": {
    "explain-it": "src/cli/main.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build --config vite.web.config.ts",
    "start": "node src/server/main.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "schemas": "node scripts/generate-schemas.ts",
    "deps": "depcruise src scripts dev --config .dependency-cruiser.cjs",
    "dev:engine": "vite --open /dev/iso.html",
    "build:engine": "vite build --config vite.render.config.ts",
    "screenshot": "node scripts/dev-screenshot.ts",
    "clip": "node scripts/dev-clip.ts",
    "shots": "node scripts/app-shots.ts",
    "shots:compare": "node scripts/compare-shots.ts",
    "layout": "node scripts/layout.ts",
    "music": "node scripts/music.ts",
    "explain-it": "node src/cli/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@swc/core": "1.16.22",
    "@tailwindcss/vite": "4.3.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "dependency-cruiser": "18.8.0",
    "fast-check": "4.10.3",
    "jsqr": "1.4.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.102",
    "@ai-sdk/openai-compatible": "3.0.90",
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@hono/node-server": "2.1.11",
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ai": "7.0.169",
    "elkjs": "0.12.1",
    "fast-json-patch": "3.1.1",
    "hono": "4.13.19",
    "jsdom": "30.1.3",
    "kokoro-js": "1.2.1",
    "lucide": "1.76.0",
    "mermaid": "12.3.0",
    "playwright-core": "1.65.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}

{
  "name": "explain-it",
  "version": "0.0.0",
  "description": "Turn any flow into an isometric explainer video.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": "github:bybash/explain-it",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "schemas": "node scripts/generate-schemas.ts",
    "deps": "depcruise src scripts --config .dependency-cruiser.cjs",
    "dev:engine": "vite --open /dev/iso.html",
    "screenshot": "node scripts/dev-screenshot.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@swc/core": "1.16.22",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.8.0",
    "fast-check": "4.10.3",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
